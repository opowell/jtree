// Price forecasts, paid by their accuracy: a forecast within a reward's relative error of the
// price earns its points (the first reward it is within).
//
// An app of its own, or a stage of each period of the market (../market), not in practice
// periods: its part "forecast" before trading, for this period and the periods ahead (horizon),
// and its part "score" after trading, which pays the forecasts made for this period, in this
// period and earlier ones, against its price (the mean, median or last trade price, or the call
// auction's), into the market's account apart from cash. Played alone (part "both"), one
// forecast of `question`, scored against `price`, for points.

const here = path.dirname(path.resolve(app.appPath));
function load(file) {
    const fn = path.join(here, file);
    delete require.cache[require.resolve(fn)];
    return require(fn);
}
const presets = load('presets.js');

app.addSelectOption('preset', Object.keys(presets.PRESETS), 'The forecasts: an example, or a study\'s (presets.js).');
app.addTextOption('changes', '', 'Settings to change, as JSON: {"forecasts": {"horizon": 1, "rewards": [[0.1, 50]], "target": "mean"}}.');
app.addSelectOption('part', ['both', 'forecast', 'score'], 'Which part: the forecasts ("forecast"), their scores ("score"), or both.');
const C = presets.settingsFor(app.preset, app.changes);
const F = C.forecasts || { horizon: 1, rewards: [], target: 'mean' };
C.rewardsText = F.rewards.map((r) => r[1] + ' if it is within ' + Math.round(r[0] * 100) + '%').join(', ');
app.config = C;
app.description = 'Price forecasts, paid ' + (C.rewardsText || 'nothing') + ' of the price.';
app.stageWrapPlayingScreenInFormTag = 'yes';

// As a stage of another app, its groups are that app's, in its order.
const ownGroups = app.getGroupIdsForPeriod;
app.getGroupIdsForPeriod = function(period) {
    if (this.parentPeriod == null) return ownGroups.call(this, period);
    const place = (id) => this.parentPeriod.playerByParticipantId(id).idInGroup;
    return this.playingGroupIds().map((ids) => ids.slice().sort((a, b) => place(a) - place(b)));
};

/** The player whose stage this app is (the market's), or, when this app is played alone, the player. */
function hostOf(player) {
    const run = player.app();
    const host = run.parentPeriod == null ? null : run.parentPeriod.playerByParticipantId(player.participant.id);
    return host == null ? player : host;
}

/** In a market: where its period is ({ practice, round, t, T }); null for an app that is not one. */
function placeOf(player) {
    const market = player.app();
    return typeof market.periodInfo === 'function' ? Object.assign(market.periodInfo(player.group.period.id), { rounds: market.config.rounds }) : null;
}

// As a stage of the market's periods: not in practice.
app.canPlayerParticipate = function(player) {
    const place = placeOf(player);
    return place == null || !place.practice;
};

const round2 = (x) => Math.round(x * 100) / 100;

/** The mean (by volume), median and last price of trades. */
function priceStats(trades) {
    if (trades.length === 0) return { mean: null, median: null, last: null };
    const prices = [];
    for (const t of trades) for (let i = 0; i < t.volume; i++) prices.push(t.price);
    prices.sort((a, b) => a - b);
    const n = prices.length;
    const ordered = trades.slice().sort((a, b) => a.time - b.time || a.id - b.id);
    return {
        mean: trades.reduce((s, t) => s + t.price * t.volume, 0) / trades.reduce((s, t) => s + t.volume, 0),
        median: n % 2 ? prices[(n - 1) / 2] : (prices[n / 2 - 1] + prices[n / 2]) / 2,
        last: ordered[ordered.length - 1].price,
    };
}

/** The price this period's forecasts are scored against, in a market (its group), or null. */
function targetIn(market) {
    const M = market.app().config;
    const a = F.asset || 0;
    if (F.target === 'call') return market.auction && market.auction[a] && market.auction[a].price != null ? market.auction[a].price : null;
    const stats = priceStats(market.trades.rows.filter((t) => t.asset === a && (t.phase === 'cda' || !M.cda)));
    return stats[F.target] != null ? stats[F.target] : null;
}

/** The reward for a forecast of price. */
function rewardFor(forecast, price) {
    if (price == null || !(price > 0)) return 0;
    const error = Math.abs(forecast - price) / price;
    const tier = F.rewards.find((r) => error <= r[0] + 1e-9);
    return tier ? tier[1] : 0;
}

const STYLE = `
<style>
.task { font-family: system-ui, -apple-system, Segoe UI, sans-serif; font-size: 15px; color: #1d2433; max-width: 760px; margin: 0 auto; padding: 12px; }
.task h2 { font-size: 20px; margin: 0 0 8px; }
.task .bar { background: #233; color: #fff; padding: 8px 12px; border-radius: 6px; }
.task table { border-collapse: collapse; font-variant-numeric: tabular-nums; }
.task td, .task th { padding: 3px 10px; text-align: left; }
.task th { color: #3b4660; font-weight: 600; border-bottom: 1px solid #c7cedc; }
.task input[type=number] { width: 110px; padding: 4px; }
.task button { padding: 5px 14px; border-radius: 4px; border: 1px solid #233; background: #233; color: #fff; cursor: pointer; font: inherit; }
</style>`;
const BAR = `<p class="bar" v-if="group.place"><span v-if="group.place.practice">Practice period {{group.place.t}} of {{group.place.T}}</span><span v-else>Period {{group.place.t}} of {{group.place.T}}<span v-if="group.place.rounds > 1"> · Market {{group.place.round}} of {{group.place.rounds}}</span></span></p>`;
const TARGETS = { mean: 'average trade price', median: 'median trade price', last: 'last trade price', call: 'market price' };

if (app.part !== 'score') {
    const forecast = app.newStage('forecast');
    forecast.groupStart = function(group) {
        const host = hostOf(group.players[0]);
        group.place = placeOf(host);
        if (group.place == null) {
            group.periods = [1];
            group.what = C.question;
        } else {
            const t = group.place.t;
            const last = F.horizon === 'all' ? group.place.T : Math.min(group.place.T, t + F.horizon - 1);
            group.periods = [];
            for (let s = t; s <= last; s++) group.periods.push(s);
            group.what = 'the ' + TARGETS[F.target] + ' of ' + host.app().config.assets[F.asset || 0].name;
        }
    };
    forecast.playerEnd = function(player) {
        const forecasts = {};
        for (const t of player.group.periods) {
            const x = Number(player['forecast' + t]);
            if (player['forecast' + t] != null && player['forecast' + t] !== '' && isFinite(x)) forecasts[t] = x;
        }
        player.forecasts = forecasts;
        const host = hostOf(player);
        if (host !== player) {
            host.forecasts = forecasts;
            host.save();
        }
    };
    forecast.activeScreen = STYLE + `
<div class="task">
    ${BAR}
    <h2>Your price forecasts</h2>
    <p>Forecast {{group.what}} in <span v-if="group.periods.length === 1">this period</span><span v-else>each of the periods below</span>.
        You earn, for each forecast, {{app.config.rewardsText}} of the price.</p>
    <table>
        <tr><th>Period</th><th>Your forecast</th></tr>
        <tr v-for="t in group.periods" :key="t"><td>{{t}}</td><td><input type="number" step="any" min="0" :name="'player.forecast' + t" required></td></tr>
    </table>
    <p><button>OK</button></p>
</div>`;
}

if (app.part !== 'forecast') {
    const score = app.newStage('forecastResults');
    score.groupStart = function(group) {
        const host0 = hostOf(group.players[0]);
        group.place = placeOf(host0);
        group.price = group.place == null ? C.price : targetIn(host0.group);
        for (const player of group.players) {
            const host = hostOf(player);
            player.forecastResults = [];
            player.forecastEarnings = 0;
            if (host === player) {
                // Played alone: the forecast just made.
                const f = player.forecasts && player.forecasts[1];
                if (f != null) player.forecastResults.push({ madeIn: 1, forecast: f, reward: rewardFor(f, group.price) });
            } else {
                // The forecasts made for this period, in it and in the periods of the round before it.
                const t = group.place.t;
                const start = host.group.period.id - t + 1;
                for (let s = 1; s <= t; s++) {
                    const made = host.inPeriod(start + s - 1);
                    const f = made && made.forecasts ? made.forecasts[t] : undefined;
                    if (f != null) player.forecastResults.push({ madeIn: s, forecast: f, reward: rewardFor(f, group.price) });
                }
            }
            player.forecastEarnings = round2(player.forecastResults.reduce((s, r) => s + r.reward, 0));
            if (host === player) {
                player.points = player.forecastEarnings;
            } else {
                host.forecastEarnings = player.forecastEarnings;
                host.forecastResults = player.forecastResults;
                host.account = round2((host.account || 0) + player.forecastEarnings);
                host.save();
            }
        }
    };
    score.activeScreen = STYLE + `
<div class="task">
    ${BAR}
    <h2>Your price forecasts</h2>
    <p v-if="group.price == null">There is no price to score the forecasts against: no units traded.</p>
    <p v-else>The price: <b>{{Math.round(group.price * 100) / 100}}</b>.</p>
    <table v-if="player.forecastResults.length > 0">
        <tr><th>Made in period</th><th>Your forecast</th><th>You earn</th></tr>
        <tr v-for="(r, i) in player.forecastResults" :key="i"><td>{{r.madeIn}}</td><td>{{r.forecast}}</td><td>{{r.reward}}</td></tr>
    </table>
    <p>Your forecast earnings: <b>{{player.forecastEarnings}}</b>.</p>
    <p><button>OK</button></p>
</div>`;
}
