// GIMS, the Graz-Innsbruck Market System (Palan 2015), for jtree: the asset market experiments of
// published studies, each put together from the apps in this folder. Each is an app of its own,
// with the presets of the studies it is part of, under the same names (its presets.js):
//
//     control-questions, crt, holt-laury   before the market (the CRT and the lotteries also after it)
//     market                               the market: its periods, accounts, trading and results
//       chat, bonds, forecasts             stages of each of its periods, before trading,
//       bonds, forecasts, lottery-ticket   after trading (the bonds back, the forecasts paid),
//       account-status, rating             and after the period's results
//     payment                              the payment of the markets, and of the rest
//
// This app is the wrapper: one period, whose groups are the markets, with these apps as its
// stages, as a study's presets have them. Choose the study (preset) when a session starts; the
// "changes" option changes any setting of any of the apps, as JSON.

const here = path.dirname(path.resolve(app.appPath));
function load(file) {
    const fn = path.join(here, file);
    delete require.cache[require.resolve(fn)];
    return require(fn);
}
const APPS = ['market', 'control-questions', 'crt', 'holt-laury', 'chat', 'bonds', 'forecasts', 'lottery-ticket', 'account-status', 'rating', 'payment'];
const presets = {};
for (const name of APPS) presets[name] = load(name + '/presets.js');

app.addSelectOption('preset', Object.keys(presets.market.PRESETS), 'The study: a published design, or GIMS\'s defaults (market/presets.js describes each).');
app.addTextOption('changes', '', 'Settings to change, in any of the apps, as JSON: {"tradingTime": 120, "traders": 8, "crtPay": 100}.');

/** The settings of an app of this folder, for the study chosen, with the changes. */
const settingsOf = (name) => presets[name].settingsFor(app.preset, app.changes);
const M = settingsOf('market');
app.config = { preset: app.preset, title: M.title, reference: M.reference, notes: M.notes };
app.description = 'GIMS (Graz-Innsbruck Market System): ' + M.title + '. ' + M.notes;
app.numPeriods = 1;
if (M.traders > 0) {
    app.groupSize = M.traders;
    app.suggestedNumParticipants = M.traders;
}
// Participants in order: the market's endowment types go by their places ("assignment").
app.groupMatchingType = 'PARTNER_1122';
if (M.exchangeRate != null) app.exchangeRate = M.exchangeRate;

/** The options of an app: the study and the changes, and more. */
const options = (more) => Object.assign({ preset: app.preset, changes: app.changes }, more);
const points = { pointsName: M.cashName };

const CQ = settingsOf('control-questions');
const CRT = settingsOf('crt');
const HL = settingsOf('holt-laury');

if (CQ.controlQuestions.length > 0) app.addApp('control-questions', options(), 'controlQuestions');
if (CRT.crt === 'before') app.addApp('crt', options(points), 'crtBefore');
if (HL.holtLaury === 'before') app.addApp('holt-laury', options(points), 'riskBefore');

// The stages of each period of the market, as its "periodApps" option.
const periodApps = { beforeTrading: [], afterTrading: [], afterResults: [] };
const stageOf = (place, name, id, more) => periodApps[place].push({ app: name, id, options: options(more) });
if (settingsOf('chat').chatTime > 0) stageOf('beforeTrading', 'chat', 'chat');
if (settingsOf('bonds').bonds != null) {
    stageOf('beforeTrading', 'bonds', 'bonds', { part: 'invest' });
    stageOf('afterTrading', 'bonds', 'bondsBack', { part: 'return' });
}
if (settingsOf('forecasts').forecasts != null) {
    stageOf('beforeTrading', 'forecasts', 'forecast', { part: 'forecast' });
    stageOf('afterTrading', 'forecasts', 'forecastResults', { part: 'score' });
}
if (settingsOf('lottery-ticket').lottery != null) stageOf('afterTrading', 'lottery-ticket', 'lottery');
if (settingsOf('account-status').accountStatus != null) stageOf('afterResults', 'account-status', 'accountStatus');
if (settingsOf('rating').rating != null) stageOf('afterResults', 'rating', 'rating');
// The payment app pays the market's rounds.
app.addApp('market', options({ periodApps, payRounds: 'no' }), 'market');

if (CRT.crt === 'after') app.addApp('crt', options(points), 'crtAfter');
if (HL.holtLaury === 'after') app.addApp('holt-laury', options(points), 'riskAfter');
app.addApp('payment', options(points), 'payment');
