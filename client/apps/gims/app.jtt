// GIMS, the Graz-Innsbruck Market System (Palan 2015), for jtree: a generic market for asset
// market experiments, in which published designs are configurations ("presets", presets.js).
//
// One or more assets are traded for cash in a continuous double auction, a call auction, or
// both, for a number of periods; after each period, assets pay a dividend. Endowment types,
// dividends, buyback values, interest on cash, cash inflows, short selling, holding caps,
// fees, trader roles, price forecasts, repeated markets and practice periods are settings, as
// are GIMS's order book rules, and the features of the published designs in presets.js:
// holding taxes, random final values with signals or news, value paths, announcements, chat,
// bonds, a computerized firm, lottery tickets and more. The market engine is in market.js.
//
// When a session starts, choose a preset; the "changes" option changes any of its settings,
// as JSON (see presets.js for every setting).

const here = path.dirname(path.resolve(app.appPath));
function load(file) {
    const fn = path.join(here, file);
    delete require.cache[require.resolve(fn)];
    return require(fn);
}
const market = load('market.js');
const presets = load('presets.js');

app.addSelectOption('preset', Object.keys(presets.PRESETS), 'The experiment: a published design, or GIMS\'s defaults (presets.js describes each).');
app.addTextOption('changes', '', 'Settings to change, as JSON: {"tradingTime": 120, "traders": 8}.');

// The settings, made whole.
const C = presets.settingsFor(app.preset, app.changes);
C.assets = C.assets.map((a) => Object.assign({ name: 'Asset', description: '', dividends: [0], dividendSequence: null, buyback: 0, signals: null, tax: 0, walk: null, maxPayouts: null }, a));
const numAssets = C.assets.length;
C.announcements = C.announcements || [];
C.byRound = C.byRound || [];
const unitsOf = (assets) => (Array.isArray(assets) ? C.assets.map((a, i) => assets[i] || 0) : C.assets.map(() => assets || 0));
C.endowments = C.endowments.map((e) => ({ cash: e.cash || 0, assets: unitsOf(e.assets), role: e.role || 'trader' }));
if (C.practiceEndowment) C.practiceEndowment = { cash: C.practiceEndowment.cash || 0, assets: unitsOf(C.practiceEndowment.assets) };
C.cda = C.mechanism === 'cda' || C.mechanism === 'call+cda';
C.call = C.mechanism === 'call' || C.mechanism === 'call+cda';
if (!C.cda && !C.call) throw new Error('GIMS: mechanism must be "cda", "call" or "call+cda", not "' + C.mechanism + '".');
const tradingTimes = Array.isArray(C.tradingTime) ? C.tradingTime : [C.tradingTime];
if (C.cda && !tradingTimes.every((x) => x > 0)) throw new Error('GIMS: tradingTime must be more than 0 seconds.');
C.maxTradingTime = Math.max(...tradingTimes);
C.separateAccount = C.dividendAccount === 'separate' || C.forecasts != null || (C.bonds != null && C.bonds.payAtEnd === true);
C.meanDividends = C.assets.map((a) => market.meanDividend(a.dividends));
// A unit's final value: its buyback (a number, or drawn for each round), with any supplement.
const supplementMean = C.supplements ? C.supplements.amounts.reduce((s, x) => s + x, 0) / numAssets : 0;
C.meanFinal = C.assets.map((a) => market.meanDividend(a.buyback) + supplementMean);
C.drawnFinal = C.assets.map((a) => typeof a.buyback !== 'number' || C.supplements != null);
C.assets.forEach((a, i) => { a.valueText = valueText(a, i); });
app.config = C;

app.description = 'GIMS (Graz-Innsbruck Market System) asset market. ' + C.title + '. ' + C.notes;
app.numPeriods = C.practicePeriods + C.rounds * C.periods;
if (C.traders > 0) {
    app.groupSize = C.traders;
    app.suggestedNumParticipants = C.traders;
}
app.groupMatchingType = 'PARTNER_1122';
if (C.exchangeRate != null) app.exchangeRate = C.exchangeRate;
app.stageWrapPlayingScreenInFormTag = 'no';
// The page: jtree's, without its period and time lines (the screens show them).
app.html = `
<!DOCTYPE html>
<html>
    <head>
        <meta http-equiv='Content-Type' content='text/html; charset=utf-8'>
        <meta name="viewport" content="width=device-width, initial-scale=1">
    </head>
    <body class='hidden'>
        <div id='jtree'>
            <span v-show='player.status=="playing"'>
                {{stages}}
            </span>
            <span v-show='["ready", "waiting", "finished", "done"].includes(player.status)'>
                {{waiting-screens}}
            </span>
        </div>
        {{scripts}}
    </body>
</html>
`;

/** How a unit's value is made up, for the screens. */
function valueText(a, i) {
    if (a.walk) return 'A unit\'s value changes by a random amount after each period, shown when the period ends, and after the last period a unit pays its value then';
    const parts = [];
    if (paysDividends(a)) parts.push('the expected dividends of the periods left');
    if (Array.isArray(a.tax) ? a.tax.some((x) => x) : a.tax) parts.push('less the holding taxes still to pay');
    if (C.drawnFinal[i]) parts.push((parts.length ? 'and ' : '') + 'its expected value after the last period (' + round2(C.meanFinal[i]) + ')');
    else if (a.buyback) parts.push((parts.length ? 'and ' : '') + a.buyback + ' a unit after the last period');
    let text = parts.length ? parts.join(', ') : 'nothing';
    text = text[0].toUpperCase() + text.slice(1);
    if (C.interest) text += ', discounted at ' + (C.interest * 100) + '% interest';
    return text;
}

/** Whether an asset pays dividends (not only zeros, and not a value path). */
function paysDividends(a) {
    if (a.walk) return false;
    const d = a.dividends;
    if (typeof d === 'number') return d !== 0;
    if (d && d.uniform) return true;
    return market.dividendProcess(d).values.some((x) => x !== 0);
}
C.assets.forEach((a) => { a.paysDividends = paysDividends(a); });

/** The seconds of trading in a round's periods (tradingTime, or its entry for the round). */
function tradingTimeIn(round) {
    return tradingTimes[Math.min(tradingTimes.length, Math.max(1, round)) - 1];
}

/** Where period n (from 1) is: a practice period, or period t of round `round`, of T. */
function periodInfo(n) {
    const P = C.practicePeriods;
    if (n <= P) return { practice: true, round: 0, t: n, T: P };
    const k = n - P - 1;
    return { practice: false, round: Math.floor(k / C.periods) + 1, t: (k % C.periods) + 1, T: C.periods };
}

/**
 * The market rules for asset a in group's period: the asset's own, or the app's, or those of
 * the block of rounds the period is in (byRound). The short reserve, a multiple of a unit's
 * value in the settings, is cash a unit here.
 */
function rulesFor(group, a) {
    const asset = C.assets[a];
    const rules = {};
    for (const k of Object.keys(market.RULES)) rules[k] = asset[k] !== undefined ? asset[k] : C[k];
    const block = group.round > 0 ? C.byRound.find((b) => group.round >= (b.from || 1) && group.round <= (b.to || Infinity)) : null;
    if (block) for (const k of Object.keys(market.RULES)) if (block[k] !== undefined) rules[k] = block[k];
    const until = asset.holdingCapUntil !== undefined ? asset.holdingCapUntil : C.holdingCapUntil;
    if (rules.holdingCap != null && until != null && group.t > until) rules.holdingCap = null;
    if (rules.shortReserve > 0) {
        const last = lastPriceOf(group, a);
        const multiple = C.shortReserveBelow != null && last != null && last < group.value[a] ? C.shortReserveBelow : rules.shortReserve;
        rules.shortReserve = multiple * Math.max(0, group.value[a]);
    }
    return rules;
}

/** The last trade price of asset a in a group's round so far, or null. */
function lastPriceOf(group, a) {
    const trades = group.trades ? group.trades.rows.filter((t) => t.asset === a) : [];
    if (trades.length > 0) return trades[trades.length - 1].price;
    const past = group.carried ? group.carried.past : [];
    for (let i = past.length - 1; i >= 0; i--) if (past[i].last[a] != null) return past[i].last[a];
    return null;
}

/** A holding tax a unit of asset a pays after period t. */
function taxIn(a, t) {
    const tax = C.assets[a].tax;
    return Array.isArray(tax) ? (tax[t - 1] || 0) : (tax || 0);
}

/**
 * The value of a unit of asset a at the start of period t of T: its expected dividends less
 * holding taxes, and its expected final value, discounted at the interest rate on cash; or, for
 * an asset whose value follows a random path, its value now (walk).
 */
function valueOf(a, t, T, walk) {
    if (C.assets[a].walk) return walk;
    const flows = [];
    for (let s = t; s <= T; s++) flows.push(C.meanDividends[a] - taxIn(a, s));
    return market.presentValue(flows, C.meanFinal[a], C.interest);
}

function inflowIn(t) {
    return Array.isArray(C.cashInflow) ? (C.cashInflow[t - 1] || 0) : (C.cashInflow || 0);
}

function round2(x) {
    return Math.round(x * 100) / 100;
}
/** A whole number from 1 to n, each equally likely. */
const draw = (n) => Math.floor(Math.random() * n) + 1;

/** A step of a random value path: one of steps (equally likely), or normal with sd. */
function walkStep(walk) {
    if (walk.steps) return walk.steps[draw(walk.steps.length) - 1];
    const u = 1 - Math.random();
    const v = Math.random();
    return round2(walk.sd * Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v));
}

// Draws the traders must not see until they are announced (a round's final values, its
// supplements), kept in memory by market and round: they are not in the group's record, which
// the pages get. If jtree restarts during a market, they are drawn again.
const secrets = new Map();
function secretOf(group) {
    const key = [group.session().id, group.period.id - group.t + 1, group.players.map((p) => p.participant.id).sort().join(',')].join('|');
    if (!secrets.has(key)) {
        const final = C.assets.map((a) => market.drawDividend(a.buyback));
        const supplement = C.assets.map(() => 0);
        let insider = null;
        if (C.supplements) {
            const assets = Utils.shuffle(C.assets.map((a, i) => i));
            C.supplements.amounts.forEach((amount, j) => { supplement[assets[j]] = amount; });
            if (!group.practice && Math.random() < (C.supplements.insider || 0)) {
                const j = draw(C.supplements.amounts.length) - 1;
                insider = { trader: group.players[draw(group.players.length) - 1].idInGroup, asset: assets[j], amount: C.supplements.amounts[j] };
            }
        }
        secrets.set(key, { final: final.map((x, i) => x + supplement[i]), supplement, insider });
    }
    return secrets.get(key);
}

/** A unit's value after the last period of a round: its path's last value, or its final value. */
function finalValueOf(group, a) {
    if (C.assets[a].walk) return group.carried.walk[a];
    return C.drawnFinal[a] ? secretOf(group).final[a] : C.assets[a].buyback;
}

// The computerized firm (Haruvy, Noussair and Powell 2014) trades as trader 0, with all the
// cash and units it needs. Its accounts are kept by group, apart from the group's record.
const FIRM = 0;
const firms = new Map();
function firmAccount(group) {
    if (!firms.has(group)) {
        firms.set(group, { cash: Infinity, assets: C.assets.map(() => Infinity), role: C.firm.side === 'buy' ? 'buyer' : 'seller', bought: C.assets.map(() => 0) });
    }
    return firms.get(group);
}

/** The market, as market.js sees it, of a group. */
function bookOf(group) {
    return {
        orders: group.orders.rows,
        trades: group.trades.rows,
        addOrder(row) { group.orders.new(row); return row; },
        addTrade(row) { group.trades.new(row); return row; },
        trader: (id) => (id === FIRM && C.firm ? firmAccount(group) : group.playerWithId(id)),
        rules: (a) => rulesFor(group, a),
        now: () => round2((Date.now() - (group.marketStart || Date.now())) / 1000),
    };
}

/** Endowment types for players who have none yet, in equal numbers (GIMS's assignment). */
function assignTypes(group) {
    const players = group.players.filter((p) => p.participant.gimsType == null);
    if (players.length === 0) return;
    const n = group.players.length;
    const k = C.endowments.length;
    const per = Math.floor(n / k);
    const types = [];
    for (let type = 1; type <= k; type++) for (let i = 0; i < per; i++) types.push(type);
    while (types.length < n) types.push(Math.min(C.fillerType, k));
    if (C.assignment === 'random') Utils.shuffle(types);
    const sorted = group.players.slice().sort((a, b) => a.idInGroup - b.idInGroup);
    sorted.forEach((p, i) => {
        if (p.participant.gimsType == null) p.participant.gimsType = types[i];
    });
}

/**
 * What a market carries from period to period, all of it known to its traders: its history
 * (past: a row a period), the values of assets whose values follow a path, how many dividends
 * each asset has paid, the bond rate, the firm's trades, and draws made once a session (draws).
 * It is kept with each trader's record, so that it is saved.
 */
function carriedFor(group) {
    const before = group.players.map((p) => p.old()).find((x) => x != null && x.carried != null);
    if (before != null && !group.firstPeriod) return JSON.parse(JSON.stringify(before.carried));
    return {
        past: [],
        walk: C.assets.map((a) => (a.walk ? a.walk.start : null)),
        payouts: C.assets.map(() => 0),
        perUnit: C.assets.map(() => 0),
        bondRate: C.bonds ? (Array.isArray(C.bonds.rate) ? C.bonds.rate[0] : C.bonds.rate) : null,
        firmTraded: 0,
        draws: before != null && before.carried.draws ? before.carried.draws : {},
    };
}

/**
 * Sets up a group's period, once: its order book, its place in the rounds, and each trader's
 * account, carried over from the period before or, at a round's start, the endowment.
 */
function setUp(group) {
    if (group.gimsReady) return;
    group.gimsReady = true;
    Object.assign(group, periodInfo(group.period.id));
    group.firstPeriod = group.t === 1;
    group.lastPeriod = group.t === group.T;
    group.tradingTime = tradingTimeIn(group.round);
    group.addTable('orders');
    group.addTable('trades');
    if (C.chatTime > 0) group.addTable('chat');
    group.carried = carriedFor(group);
    group.value = C.assets.map((a, i) => round2(valueOf(i, group.t, group.T, group.carried.walk[i])));
    group.valueTable = C.assets.map((a, i) => valueRows(group, i));
    group.dividend = C.assets.map(() => null);
    group.auction = C.assets.map(() => null);
    group.indicative = C.assets.map(() => null);
    group.stats = C.assets.map(() => null);
    group.final = null;
    group.news = null;
    group.lotteryWin = null;
    group.bondRate = C.bonds ? bondRateFor(group) : null;
    group.carried.bondRate = group.bondRate;
    group.announcements = announcementsFor(group);
    if (group.firstPeriod && C.reassignTypes && !group.practice) {
        for (const p of group.players) p.participant.gimsType = null;
    }
    assignTypes(group);
    for (const player of group.players) {
        const type = C.endowments[player.participant.gimsType - 1];
        const before = player.old();
        player.type = player.participant.gimsType;
        player.role = type.role;
        player.carried = group.carried;
        if (group.firstPeriod || before == null) {
            const e = group.practice && C.practiceEndowment ? C.practiceEndowment : type;
            // With carryCash, cash carries over from one round to the next (Palfrey and Wang 2012).
            const carry = C.carryCash && before != null && !group.practice && group.round > 1 && before.finalCash != null;
            player.cash = carry ? before.finalCash : e.cash;
            player.assets = e.assets.slice();
            player.account = 0;
            player.initialCash = player.cash;
            player.initialAssets = e.assets.slice();
            player.held = [];
            player.insider = null;
            player.signal = null;
        } else {
            player.cash = before.cash;
            player.assets = before.assets.slice();
            player.account = before.account;
            player.initialCash = before.initialCash;
            player.initialAssets = before.initialAssets.slice();
            player.held = (before.held || []).slice();
            player.insider = before.insider || null;
            player.signal = before.signal || null;
        }
        player.startCash = player.cash;
        player.startAssets = player.assets.slice();
        player.bought = C.assets.map(() => 0);
        player.callOrders = [];
        player.forecasts = {};
        player.voted = false;
        player.notice = null;
        player.signals = C.assets.map((a) => signalsFor(a, group, player));
        player.tasks = before != null && group.practice && !group.firstPeriod
            ? Object.assign({}, before.tasks)
            : { buyOrder: false, sellOrder: false, cancel: false, acceptBuy: false, acceptSell: false };
        player.dividends = 0;
        player.interestEarned = 0;
        player.inflow = 0;
        player.forecastEarnings = 0;
        player.forecastResults = [];
        player.roundPayoff = null;
        player.points = 0;
        player.tax = 0;
        player.bond = 0;
        player.bondInterest = 0;
        player.lotteryTicket = null;
        player.lotteryResult = 0;
        player.accountTotal = null;
        player.finalCash = null;
    }
    if (group.firstPeriod) {
        if (C.supplements) {
            const insider = secretOf(group).insider;
            for (const p of group.players) {
                p.insider = insider && insider.trader === p.idInGroup ? { asset: insider.asset, amount: insider.amount } : null;
            }
        }
        if (C.stateSignals && C.stateSignals.when === 'start') privateSignals(group);
    }
}

/** The value table of asset a for a group's round: { t, left, value } by period, as far as it is known. */
function valueRows(group, a) {
    const rows = [];
    for (let t = 1; t <= group.T; t++) {
        let value;
        if (C.assets[a].walk) {
            if (t > group.t) break;
            value = t === group.t ? group.carried.walk[a] : group.carried.past[t - 1].value[a];
        } else {
            value = valueOf(a, t, group.T);
        }
        rows.push({ t, left: group.T - t + 1, value: round2(value) });
    }
    return rows;
}

/** The texts announced to a group this period (announcements). */
function announcementsFor(group) {
    const out = [];
    if (group.practice) return out;
    C.announcements.forEach((an, i) => {
        if (!an.periods.includes(group.t)) return;
        let text = an.text;
        if (text && Array.isArray(text.draw)) {
            // One of the texts, drawn once for the session.
            const k = 'announcement' + i;
            if (group.carried.draws[k] == null) group.carried.draws[k] = text.draw[draw(text.draw.length) - 1];
            text = group.carried.draws[k];
        } else if (text && typeof text === 'object') {
            // By the mean price of the period before, against the value then.
            const before = group.carried.past[group.t - 2];
            const a = an.asset || 0;
            text = null;
            if (before && before.mean[a] != null) {
                if (before.mean[a] > before.value[a]) text = an.text.above;
                else if (before.mean[a] < before.value[a]) text = an.text.below;
            }
        }
        if (text) out.push(text);
    });
    return out;
}

/**
 * Private signals of a round's final value (stateSignals with when 'start'): high or low, right
 * with probability accuracy; with exact, the number right in each endowment type is accuracy
 * times its number of traders (Fellner and Theissen 2014).
 */
function privateSignals(group) {
    const S = C.stateSignals;
    const a = S.asset || 0;
    const values = market.dividendProcess(C.assets[a].buyback).values;
    const high = secretOf(group).final[a] >= Math.max(...values);
    const labels = S.labels || ['high', 'low'];
    const byType = new Map();
    for (const p of group.players) {
        if (!byType.has(p.type)) byType.set(p.type, []);
        byType.get(p.type).push(p);
    }
    for (const players of byType.values()) {
        const right = S.exact ? Math.round(S.accuracy * players.length) : null;
        Utils.shuffle(players.slice()).forEach((p, i) => {
            const correct = S.exact ? i < right : Math.random() < S.accuracy;
            p.signal = labels[high === correct ? 0 : 1];
        });
    }
}

/**
 * The bond rate this period (bonds): the rate, or its entry for the period; or, with a policy
 * (Fischbacher, Hens and Zeisberger 2013), raised a level in its periods when the price
 * forecast from the last three mean prices is above threshold times the value (or always, if
 * exogenous), and lowered a level as soon as the last mean price is at most the value at the
 * current rate.
 */
function bondRateFor(group) {
    const B = C.bonds;
    if (Array.isArray(B.rate)) return B.rate[Math.min(B.rate.length, group.t) - 1];
    if (B.policy == null || group.practice) return B.rate;
    const P = B.policy;
    let rate = group.t === 1 ? B.rate : group.carried.bondRate;
    const level = P.levels.indexOf(rate);
    const past = group.carried.past;
    const mean = (t) => (past[t - 1] && past[t - 1].mean[0] != null ? past[t - 1].mean[0] : null);
    const last = mean(group.t - 1);
    const flows = [];
    for (let s = group.t - 1; s <= group.T; s++) flows.push(C.meanDividends[0]);
    if (last != null && level > P.levels.indexOf(B.rate) && last <= market.presentValue(flows, 0, rate)) return P.levels[level - 1];
    if (P.periods.includes(group.t) && level < P.levels.length - 1) {
        if (P.exogenous) return P.levels[level + 1];
        const [p1, p2, p3] = [mean(group.t - 1), mean(group.t - 2), mean(group.t - 3)];
        if (p1 != null && p2 != null && p3 != null) {
            const forecast = (4 / 3) * p1 + (1 / 3) * p2 - (2 / 3) * p3;
            if (forecast > P.threshold * group.value[0]) return P.levels[level + 1];
        }
    }
    return rate;
}

/** The signals a player sees for an asset this period: the set for their place in the market. */
function signalsFor(asset, group, player) {
    const byPeriod = asset.signals;
    if (byPeriod == null) return null;
    const sets = typeof byPeriod === 'function' ? byPeriod({ period: group.t, round: group.round, trader: player.idInGroup }) : byPeriod[group.t - 1];
    if (sets == null) return null;
    if (!Array.isArray(sets[0])) return sets;
    return sets[(player.idInGroup - 1) % sets.length];
}

/** Sends a trader their page's data again: saves only, while they have not yet entered a stage. */
function refresh(player) {
    if (player.stage == null) player.save();
    else player.saveAndUpdate();
}

/** Sends every trader of a group their page's data again. */
function update(group) {
    for (const p of group.players) refresh(p);
}

let noticeCount = 0;
function notify(player, text) {
    player.notice = { text, n: ++noticeCount };
    player.saveAndUpdate();
}

/** The player sending a message, if they are playing stageId now. */
function playerIn(participant, stageId) {
    const player = participant.player;
    if (player == null || player.status !== 'playing' || player.stage.id !== stageId) return null;
    return player;
}

const assetIndex = (a) => (Number.isInteger(a) && a >= 0 && a < numAssets ? a : null);

// Timers that are not saved with the group (indicative prices).
const timers = new Map();

// Shared look of the screens.
const STYLE = `
<style>
body { display: block; max-width: none; margin: 0; }
#jtree { min-width: 0; min-height: 0; border: 0; background: none; margin: 0; padding: 0; }
.gims button, .gims input, .gims select { font: inherit; font-size: 14px; line-height: 1.3; }
.gims { font-family: system-ui, -apple-system, Segoe UI, sans-serif; font-size: 15px; color: #1d2433; max-width: 1180px; margin: 0 auto; padding: 12px; }
.gims h2 { font-size: 20px; margin: 0 0 8px; }
.gims h3 { font-size: 15px; margin: 0 0 6px; color: #3b4660; text-transform: uppercase; letter-spacing: .04em; }
.gims .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; background: #233; color: #fff; padding: 8px 12px; border-radius: 6px; margin-bottom: 10px; }
.gims .bar b { font-variant-numeric: tabular-nums; }
.gims .grid { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(320px, 1.6fr) minmax(240px, 1.3fr); gap: 10px; }
@media (max-width: 900px) { .gims .grid { grid-template-columns: 1fr; } }
.gims .box { background: #f4f6fa; border: 1px solid #d5dae5; border-radius: 6px; padding: 10px; }
.gims table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
.gims td, .gims th { padding: 3px 6px; text-align: right; }
.gims th { color: #3b4660; font-weight: 600; border-bottom: 1px solid #c7cedc; }
.gims td:first-child, .gims th:first-child { text-align: left; }
.gims td + td { white-space: nowrap; }
.gims .book { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.gims .orders { min-height: 140px; max-height: 230px; overflow-y: auto; background: #fff; border: 1px solid #d5dae5; border-radius: 4px; }
.gims .orders div { display: flex; justify-content: space-between; padding: 2px 6px; font-variant-numeric: tabular-nums; }
.gims .orders .mine { color: #1747c9; font-weight: 600; }
.gims .orders .best { background: #fff4cc; }
.gims .orders button { padding: 0 6px; font-size: 12px; }
.gims .entry { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 8px; }
.gims input[type=number] { width: 90px; padding: 4px; }
.gims button { padding: 5px 10px; border-radius: 4px; border: 1px solid #8893aa; background: #fff; color: #1d2433; cursor: pointer; white-space: nowrap; }
.gims button:hover { color: #1d2433; background: #e8ecf4; border-color: #5d6884; }
.gims button.buy { background: #e2f5e6; border-color: #3d9a52; }
.gims button.sell { background: #fbe4e4; border-color: #c24848; }
.gims button.primary { background: #233; color: #fff; border-color: #233; }
.gims button:disabled { opacity: .45; cursor: default; }
.gims .tabs { display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap; }
.gims .tabs button.on { background: #233; color: #fff; }
/* Messages take a slot of their own, so that the screen does not move under the mouse. */
.gims .notice-slot { min-height: 34px; margin-bottom: 8px; }
.gims .notice { background: #fff3cd; border: 1px solid #e0c065; padding: 6px 10px; border-radius: 4px; }
.gims .muted { color: #667189; font-size: 13px; }
.gims .up { color: #18803a; } .gims .down { color: #b3261e; }
.gims .done { color: #18803a; }
.gims .scroll { max-height: 200px; overflow-y: auto; }
.gims .question { margin: 12px 0; }
.gims .question label { display: block; margin: 3px 0; }
</style>`;

const BAR = `
<div class="bar">
    <span v-if="group.practice">Practice period {{group.t}} of {{group.T}}</span>
    <span v-else>Period {{group.t}} of {{group.T}}<span v-if="app.config.rounds > 1"> · Market {{group.round}} of {{app.config.rounds}}</span></span>
    <span v-if="hasTimeout">Time left: <b>{{mmss(clock.totalSeconds)}}</b></span>
</div>`;

// Templates' helpers, run in the participant's page.
app.vueModels = { sel: 0, price: '', volume: 1, history: 'all', callType: 'buy', callMarket: false, chatText: '' };
app.vueComputed = {
    me: function() { return this.player.idInGroup; },
    asset: function() { return this.app.config.assets[this.sel]; },
    book: function() {
        let me = this.player.idInGroup;
        let depth = this.app.config.orderBookDepth;
        let sel = this.sel;
        let side = function(orders, type) {
            let list = orders.filter(function(o) { return o.status === 'open' && o.asset === sel && o.type === type && o.phase === 'cda'; });
            list.sort(function(a, b) { return (type === 'buy' ? b.price - a.price : a.price - b.price) || a.time - b.time || a.id - b.id; });
            let others = 0;
            return list.filter(function(o) { return o.maker === me || depth < 0 || others++ < depth; });
        };
        let orders = this.group.orders || [];
        let bids = side(orders, 'buy');
        let asks = side(orders, 'sell');
        let bestBid = bids.find(function(o) { return o.maker !== me; }) || null;
        let bestAsk = asks.find(function(o) { return o.maker !== me; }) || null;
        return { bids: bids, asks: asks, bestBid: bestBid, bestAsk: bestAsk };
    },
    left: function() {
        return function(o) { return o.volume - o.transacted - o.invalidated; };
    },
    priceList: function() {
        let sel = this.sel;
        let list = (this.group.trades || []).filter(function(t) { return t.asset === sel; }).slice().reverse();
        let depth = this.app.config.priceListDepth;
        return depth > 0 ? list.slice(0, depth) : list;
    },
    myHistory: function() {
        let me = this.player.idInGroup;
        let filter = this.history;
        let sel = this.sel;
        let status = { traded: 'traded', cancelled: 'cancelled', invalidated: 'invalidated' }[filter];
        return (this.group.orders || []).filter(function(o) {
            return o.maker === me && o.asset === sel && o.status !== 'open' && (filter === 'all' || o.status === status || (filter === 'traded' && o.transacted > 0));
        }).slice().reverse();
    },
    chart: function() {
        let sel = this.sel;
        let trades = (this.group.trades || []).filter(function(t) { return t.asset === sel && t.phase === 'cda'; });
        let value = this.app.config.showFundamentalValue ? this.group.value[sel] : null;
        let top = Math.max(1, value || 0);
        trades.forEach(function(t) { top = Math.max(top, t.price); });
        top = top * 1.3;
        let W = 300, H = 160;
        let T = Math.max(1, this.group.tradingTime || this.app.config.maxTradingTime);
        let pts = trades.map(function(t) { return { x: Math.min(W, t.time / T * W), y: H - t.price / top * H }; });
        return {
            W: W, H: H, top: Math.round(top),
            points: pts,
            line: pts.map(function(p) { return p.x.toFixed(1) + ',' + p.y.toFixed(1); }).join(' '),
            value: value == null ? null : H - value / top * H,
        };
    },
    myCallOrders: function() {
        let sel = this.sel;
        return (this.player.callOrders || []).filter(function(o) { return o.asset === sel; });
    },
    forecastPeriods: function() {
        let f = this.app.config.forecasts;
        if (f == null) return [];
        let last = f.horizon === 'all' ? this.group.T : Math.min(this.group.T, this.group.t + f.horizon - 1);
        let out = [];
        for (let t = this.group.t; t <= last; t++) out.push(t);
        return out;
    },
    tasksList: function() {
        let t = this.player.tasks || {};
        return [
            { done: t.buyOrder, text: 'Submit a buy order.' },
            { done: t.sellOrder, text: 'Submit a sell order.' },
            { done: t.cancel, text: 'Cancel one of your orders.' },
            { done: t.acceptSell, text: 'Accept a sell order (Buy).' },
            { done: t.acceptBuy, text: 'Accept a buy order (Sell).' },
        ];
    },
    valueTable: function() {
        return (this.group.valueTable || [])[this.sel] || [];
    },
    /** The market's history this round: a row a period, newest first. */
    pastRows: function() {
        return ((this.group.carried && this.group.carried.past) || []).slice().reverse();
    },
    /** The news so far this round (stateSignals with when 'end'). */
    hasTax: function() {
        return this.app.config.assets.some(function(a) { return Array.isArray(a.tax) ? a.tax.some(function(x) { return x; }) : !!a.tax; });
    },
    paysAny: function() {
        return this.app.config.assets.some(function(a) { return a.paysDividends; });
    },
    hasWalk: function() {
        return this.app.config.assets.some(function(a) { return !!a.walk; });
    },
    newsSoFar: function() {
        return ((this.group.carried && this.group.carried.past) || []).filter(function(r) { return r.news != null; }).map(function(r) { return r.news; });
    },
};
app.vueMethods = {
    mmss: function(seconds) {
        seconds = Math.max(0, Math.round(seconds || 0));
        return Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0');
    },
    fmt: function(x) {
        if (x == null) return '–';
        return Math.round(x * 100) / 100;
    },
    send: function(name, data) {
        jt.sendMessage(name, data);
    },
    /** What the account apart from cash holds. */
    accountName: function() {
        let C = this.app.config;
        if (C.forecasts == null) return 'Dividend account';
        return C.dividendAccount === 'separate' ? 'Dividend and forecast account' : 'Forecast account';
    },
    /** The holding tax a unit of asset i pays after this period. */
    taxNow: function(i) {
        let tax = this.app.config.assets[i].tax;
        return Array.isArray(tax) ? (tax[this.group.t - 1] || 0) : (tax || 0);
    },
    /** How a market's earnings are made up. */
    earningsText: function() {
        let C = this.app.config;
        let text = 'Cash' + (C.separateAccount ? ' and account' : '');
        if (this.player.buybackValue) text += ', ' + this.fmt(this.player.buybackValue) + ' for your units';
        if (C.bonus) text += ', and ' + C.bonus;
        if (C.payoff === 'profit') text += ', less what your starting cash and units would have paid had you kept them';
        else if (C.carryCash && this.group.round > 1) text += ', less the cash you began this market with';
        else if (C.loan) text += ', less your starting cash (a loan)';
        return text + '.';
    },
    /** Money per point: the app's exchange rate, or the session's. */
    moneyRate: function() {
        if (this.app.exchangeRate != null) return this.app.exchangeRate;
        let s = this.participant.session;
        return s && s.exchangeRate != null ? s.exchangeRate : null;
    },
    /** The last trade price of asset a this period, or null. */
    lastPrice: function(a) {
        let trades = (this.group.trades || []).filter(function(t) { return t.asset === a; });
        return trades.length > 0 ? trades[trades.length - 1].price : null;
    },
    /** Units of asset a the player bought (side 'buyer') or sold ('seller') in the call auction. */
    callUnits: function(a, side) {
        let me = this.player.idInGroup;
        return (this.group.trades || []).filter(function(t) { return t.asset === a && t.phase === 'call' && t[side] === me; })
            .reduce(function(s, t) { return s + t.volume; }, 0);
    },
};

const ASSET_TABS = `
<div class="tabs" v-if="app.config.assets.length > 1">
    <button v-for="(a, i) in app.config.assets" :key="i" :class="{on: sel === i}" @click="sel = i">
        {{a.name}} · you hold {{player.assets[i]}}<span v-if="lastPrice(i) != null"> · last {{fmt(lastPrice(i))}}</span>
    </button>
</div>`;

const ACCOUNT = `
<div class="box">
    <h3>Your account</h3>
    <table>
        <tr><td>Cash</td><td><b>{{fmt(player.cash)}}</b> {{app.config.cashName}}</td></tr>
        <tr v-for="(a, i) in app.config.assets" :key="i"><td>{{a.name}}</td><td><b>{{player.assets[i]}}</b> {{player.assets[i] === 1 ? 'unit' : 'units'}}</td></tr>
        <tr v-if="app.config.separateAccount"><td>{{accountName()}}</td><td>{{fmt(player.account)}}</td></tr>
        <tr v-if="player.role !== 'trader'"><td>Your role</td><td><b>{{player.role}}</b></td></tr>
    </table>
    <p v-if="asset.description" class="muted">{{asset.description}}</p>
    <div v-if="app.config.showFundamentalValue" style="margin-top: 8px">
        <h3>Value of a unit</h3>
        <p class="muted">{{asset.valueText}}: now <b>{{fmt(group.value[sel])}}</b>.</p>
        <div class="scroll"><table>
            <tr><th>Period</th><th>Periods left</th><th>Value</th></tr>
            <tr v-for="r in valueTable" :key="r.t" :style="r.t === group.t ? 'font-weight: 700' : ''"><td>{{r.t}}</td><td>{{r.left}}</td><td>{{r.value}}</td></tr>
        </table></div>
    </div>
    <div v-if="player.signals && player.signals[sel]" style="margin-top: 8px">
        <h3>Signals</h3>
        <div v-for="(s, i) in player.signals[sel]" :key="i">{{s}}</div>
    </div>
    <div v-if="player.signal" style="margin-top: 8px">
        <h3>Your signal</h3>
        <div>The value of {{app.config.assets[app.config.stateSignals.asset || 0].name}} is <b>{{player.signal}}</b>, says your signal (right with probability {{app.config.stateSignals.accuracy}}).</div>
    </div>
    <div v-if="app.config.stateSignals && app.config.stateSignals.when === 'end'" style="margin-top: 8px">
        <h3>News</h3>
        <div v-if="newsSoFar.length === 0" class="muted">No news yet. News comes after each period.</div>
        <div v-else>{{newsSoFar.join(', ')}}</div>
    </div>
    <div v-if="player.insider" style="margin-top: 8px">
        <h3>Private information</h3>
        <div>{{app.config.assets[player.insider.asset].name}} has a supplement of <b>{{player.insider.amount}}</b>. No one else knows this.</div>
    </div>
</div>`;

const ANNOUNCEMENTS = `
<div class="notice" style="margin-bottom: 8px; font-weight: 600" v-for="(text, i) in group.announcements" :key="'an' + i">{{text}}</div>`;

const HISTORY = `
<div class="box" v-if="app.config.showHistory && pastRows.length > 0" style="margin-top: 10px">
    <h3>Earlier periods</h3>
    <div class="scroll"><table>
        <tr><th>Period</th><th v-for="(a, i) in app.config.assets" :key="i">{{a.name}}: last price</th><th>Value</th><th v-if="paysAny">Dividend</th><th v-if="newsSoFar.length > 0">News</th></tr>
        <tr v-for="r in pastRows" :key="r.t"><td>{{r.t}}</td><td v-for="(a, i) in app.config.assets" :key="i">{{fmt(r.last[i])}}</td>
            <td>{{fmt(r.value[sel])}}</td><td v-if="paysAny">{{fmt(r.dividend[sel])}}</td><td v-if="newsSoFar.length > 0">{{r.news || ''}}</td></tr>
    </table></div>
</div>`;

// Stages, in the order they come in a period; each only when the settings use it.

function inPeriodOne(player) {
    return player.group.period.id === 1;
}
function inLastPeriod(player) {
    return player.group.period.id === app.numPeriods;
}

// Before the market, in its first period, and after it, in its last: control questions, the
// cognitive reflection test and Holt and Laury's lottery choices, as the settings say. Each is an
// app of its own (../control-questions, ../crt, ../holt-laury), added here as a stage; their
// points are the market's, at its exchange rate. TASKS: their stages, with what the payment
// screen calls their earnings.
const TASKS = [];
function addTask(file, options, id, when, label) {
    const stage = app.addApp(file, options, id);
    stage.canPlayerParticipate = when;
    TASKS.push({ id, label });
}
const crtOptions = { pay: C.crtPay, pointsName: C.cashName };
const holtLauryOptions = Object.assign({ pointsName: C.cashName }, C.holtLauryPayoffs);

if (C.controlQuestions.length > 0) addTask('../control-questions', { questions: C.controlQuestions, intro: C.controlQuestionsIntro }, 'controlQuestions', inPeriodOne, 'The questions about the instructions');
if (C.crt === 'before') addTask('../crt', crtOptions, 'crtBefore', inPeriodOne, 'The three questions');
if (C.holtLaury === 'before') addTask('../holt-laury', holtLauryOptions, 'riskBefore', inPeriodOne, 'The lottery choices');

// A chat before trading (Oechssler, Schmidt and Schnedler 2011): from period chatFrom of each
// round, for chatTime seconds. Each message shows its sender's trader number and wealth (cash
// and units at the last prices, or at their value before an asset has traded).
if (C.chatTime > 0) {
    const chat = app.newStage('chat');
    chat.canPlayerParticipate = (player) => {
        const info = periodInfo(player.group.period.id);
        return !info.practice && info.t >= (C.chatFrom || 1);
    };
    chat.groupStart = setUp;
    chat.duration = C.chatTime;
    chat.wrapPlayingScreenInFormTag = 'no';
    chat.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    <h2>Chat</h2>
    <p class="muted">Before trading opens, you can write to the other traders. Everyone sees every message.</p>
    <div class="box" style="max-width: 720px">
        <div class="scroll" style="max-height: 320px; min-height: 160px">
            <div v-for="m in (group.chat || [])" :key="m.id"><b>Trader {{m.from}}</b> <span class="muted">(wealth {{fmt(m.wealth)}})</span>: {{m.text}}</div>
            <div v-if="(group.chat || []).length === 0" class="muted">No messages yet.</div>
        </div>
        <div class="entry"><input type="text" maxlength="300" style="flex: 1; padding: 4px" v-model="chatText" @keydown.enter.prevent="send('gimsChat', {text: chatText}); chatText = ''">
            <button type="button" class="primary" @click="send('gimsChat', {text: chatText}); chatText = ''">Send</button></div>
    </div>
</div>`;
}

// Bonds (Fischbacher, Hens and Zeisberger 2013): before trading, each trader puts some of their
// cash into a one-period bond at the period's rate. It cannot be used to trade, and comes back
// with interest after the period (or the interest is paid at the end, with payAtEnd).
if (C.bonds != null) {
    const bonds = app.newStage('bonds');
    bonds.groupStart = setUp;
    bonds.wrapPlayingScreenInFormTag = 'yes';
    app.fields = app.fields || {};
    app.fields['player.bondInput'] = { type: 'number', min: 0 };
    bonds.formFields = ['player.bondInput'];
    bonds.validate = function(player, values) {
        const x = Number(values['player.bondInput']);
        if (!(x >= 0) || x > player.cash + 1e-9) return { 'player.bondInput': 'Enter an amount from 0 to your cash, ' + round2(player.cash) + '.' };
        return undefined;
    };
    bonds.playerEnd = function(player) {
        player.bond = round2(Math.min(player.cash, Math.max(0, Number(player.bondInput) || 0)));
        player.cash = round2(player.cash - player.bond);
    };
    bonds.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    <h2>Bonds</h2>
    <p>The interest rate on bonds this period is <b>{{fmt(group.bondRate * 100)}}%</b>. Money you put into bonds earns interest but cannot be used to buy units this period; it comes back <span v-if="app.config.bonds.payAtEnd">after the period, and its interest at the end of the experiment</span><span v-else>with its interest after the period</span>.</p>
    <p>Your cash: <b>{{fmt(player.cash)}}</b> {{app.config.cashName}}. Your units: <span v-for="(a, i) in app.config.assets" :key="i">{{player.assets[i]}} {{a.name}} </span></p>
    <p><label>Put into bonds: <input type="number" min="0" step="any" name="player.bondInput" :max="player.cash" required></label></p>
    <p><button class="primary">OK</button></p>
</div>`;
}

if (C.forecasts != null) {
    const f = app.newStage('forecast');
    f.canPlayerParticipate = (player) => !periodInfo(player.group.period.id).practice;
    f.groupStart = setUp;
    f.wrapPlayingScreenInFormTag = 'yes';
    f.playerEnd = function(player) {
        const C2 = C.forecasts;
        const last = C2.horizon === 'all' ? player.group.T : Math.min(player.group.T, player.group.t + C2.horizon - 1);
        const forecasts = {};
        for (let t = player.group.t; t <= last; t++) {
            const x = Number(player['forecast' + t]);
            if (player['forecast' + t] != null && player['forecast' + t] !== '' && isFinite(x)) forecasts[t] = x;
        }
        player.forecasts = forecasts;
    };
    f.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    <h2>Your price forecasts</h2>
    <p>Forecast the {{ {mean: 'average trade price', median: 'median trade price', last: 'last trade price', call: 'market price'}[app.config.forecasts.target] }} of {{app.config.assets[app.config.forecasts.asset || 0].name}} in
        <span v-if="forecastPeriods.length === 1">this period</span><span v-else>each of the periods below</span>.
        You earn, for each forecast,
        <span v-for="(r, i) in app.config.forecasts.rewards" :key="i">{{r[1]}} if it is within {{r[0] * 100}}%<span v-if="i < app.config.forecasts.rewards.length - 1">, </span></span> of the price.</p>
    <table style="max-width: 360px">
        <tr><th>Period</th><th>Your forecast</th></tr>
        <tr v-for="t in forecastPeriods" :key="t"><td>{{t}}</td><td><input type="number" step="any" min="0" :name="'player.forecast' + t" required></td></tr>
    </table>
    <p><button class="primary">OK</button></p>
</div>`;
}

if (C.call) {
    const call = app.newStage('callAuction');
    call.groupStart = function(group) {
        setUp(group);
        group.marketStart = Date.now();
        if (C.indicativePriceInterval > 0) {
            timers.set(group, setInterval(() => {
                group.indicative = C.assets.map((a, i) => market.auctionPrice(callOrdersOf(group, i), rulesFor(group, i).tickSize).price);
                update(group);
            }, C.indicativePriceInterval * 1000));
        }
    };
    call.groupEnd = function(group) {
        clearInterval(timers.get(group));
        timers.delete(group);
    };
    if (C.callTime > 0) call.duration = C.callTime;
    call.wrapPlayingScreenInFormTag = 'yes';
    call.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    ${ASSET_TABS}
    <div class="notice-slot"><div class="notice" v-if="player.notice" :key="player.notice.n">{{player.notice.text}}</div></div>
    <div class="grid" style="grid-template-columns: minmax(200px, 1fr) minmax(320px, 2fr)">
        ${ACCOUNT}
        <div class="box">
            <h3>Call auction: {{asset.name}}</h3>
            <p class="muted">Submit your buy and sell orders. When everyone is done, one price is found at which as many units as possible trade, and all trades are at that price.
                <span v-if="app.config.callMaxOrders > 0">You may submit {{app.config.callMaxOrders}} buy and {{app.config.callMaxOrders}} sell order(s).</span></p>
            <p v-if="group.indicative[sel] != null">Indicative price now: <b>{{fmt(group.indicative[sel])}}</b></p>
            <div class="entry">
                <select v-model="callType"><option value="buy">Buy</option><option value="sell">Sell</option></select>
                <label v-if="app.config.multiUnit">Units <input type="number" min="1" step="1" v-model="volume" @keydown.enter.prevent></label>
                <label v-if="!callMarket">Price per unit <input type="number" min="0" step="any" v-model="price" @keydown.enter.prevent></label>
                <label v-if="app.config.marketOrders"><input type="checkbox" v-model="callMarket"> at any price (market order)</label>
                <button type="button" :class="callType" @click="send('gimsCallOrder', {asset: sel, type: callType, price: callMarket ? null : price - 0, volume: volume - 0})">Submit order</button>
            </div>
            <h3 style="margin-top: 10px">Your orders</h3>
            <table>
                <tr><th>Order</th><th>Units</th><th>Price</th><th></th></tr>
                <tr v-for="o in myCallOrders" :key="o.id"><td>{{o.type === 'buy' ? 'Buy' : 'Sell'}}</td><td>{{o.volume}}</td><td>{{o.price == null ? 'any' : o.price}}</td>
                    <td><button type="button" @click="send('gimsCallCancel', {id: o.id})">Cancel</button></td></tr>
                <tr v-if="myCallOrders.length === 0"><td colspan="4" class="muted">None yet.</td></tr>
            </table>
            <p style="margin-top: 10px"><button class="primary">I am done</button></p>
        </div>
    </div>
</div>`;

    const callResults = app.newStage('callResults');
    callResults.groupStart = function(group) {
        setUp(group);
        const book = bookOf(group);
        for (let a = 0; a < numAssets; a++) {
            const auction = market.runCallAuction(book, a, callOrdersOf(group, a));
            group.auction[a] = { price: auction.price, volume: auction.volume, rule: auction.rule };
        }
        // All orders, without who made them, for showCallOrders.
        group.callBook = C.showCallOrders ? C.assets.map((x, a) => callOrdersOf(group, a).map((o) => ({ type: o.type, price: o.price, volume: o.volume }))
            .sort((p, q) => (p.type === q.type ? (p.type === 'buy' ? q.price - p.price : p.price - q.price) : p.type === 'buy' ? -1 : 1))) : null;
        for (const p of group.players) p.callOrders = [];
        group.stats = C.assets.map((x, a) => market.priceStats(group.trades.rows.filter((t) => t.asset === a)));
        group.orders.save();
        group.trades.save();
    };
    if (C.resultsTime > 0) callResults.duration = C.resultsTime;
    callResults.wrapPlayingScreenInFormTag = 'yes';
    callResults.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    <h2>Call auction results</h2>
    <table style="max-width: 640px">
        <tr><th>Asset</th><th>Price</th><th>Units traded</th><th>You bought</th><th>You sold</th><th>You hold</th></tr>
        <tr v-for="(a, i) in app.config.assets" :key="i">
            <td>{{a.name}}</td><td>{{group.auction[i] && group.auction[i].price != null ? fmt(group.auction[i].price) : 'no trade'}}</td>
            <td>{{group.auction[i] ? group.auction[i].volume : 0}}</td>
            <td>{{callUnits(i, 'buyer')}}</td>
            <td>{{callUnits(i, 'seller')}}</td>
            <td>{{player.assets[i]}}</td>
        </tr>
    </table>
    <p>Your cash: <b>{{fmt(player.cash)}}</b> {{app.config.cashName}}.</p>
    <div v-if="group.callBook" style="max-width: 640px">
        <h3>All orders: {{asset.name}}</h3>
        <table>
            <tr><th>Order</th><th>Price</th><th>Units</th></tr>
            <tr v-for="(o, i) in group.callBook[sel]" :key="i"><td>{{o.type === 'buy' ? 'Buy' : 'Sell'}}</td><td>{{o.price == null ? 'any' : fmt(o.price)}}</td><td>{{o.volume}}</td></tr>
        </table>
    </div>
    <button class="primary">OK</button>
</div>`;
}

/** A group's call auction orders for asset a, from its traders. */
function callOrdersOf(group, a) {
    const out = [];
    for (const p of group.players) {
        for (const o of p.callOrders || []) if (o.asset === a) out.push(Object.assign({}, o, { maker: p.idInGroup }));
    }
    return out;
}

if (C.cda) {
    const trading = app.newStage('trading');
    trading.duration = C.maxTradingTime;
    // The period's length: tradingTime, or its entry for the round.
    trading.getGroupDuration = (group) => tradingTimeIn(periodInfo(group.period.id).round);
    trading.waitOnTimerEnd = false;
    trading.groupStart = function(group) {
        setUp(group);
        group.marketStart = Date.now();
        if (firmActive(group)) timers.set(group, setInterval(() => firmAct(group), C.firm.interval * 1000));
        update(group);
    };
    trading.groupEnd = function(group) {
        clearInterval(timers.get(group));
        timers.delete(group);
        market.expireOrders(bookOf(group));
        group.orders.save();
    };
    trading.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    ${ANNOUNCEMENTS}
    ${ASSET_TABS}
    <div class="notice-slot"><div class="notice" v-if="player.notice" :key="player.notice.n">{{player.notice.text}}</div></div>
    <div class="grid">
        ${ACCOUNT}
        <div class="box">
            <h3>{{asset.name}}: orders</h3>
            <div class="book">
                <div>
                    <div class="muted">Buy orders (bids)</div>
                    <div class="orders">
                        <div v-for="o in book.bids" :key="o.id" :class="{mine: o.maker === me, best: book.bestBid && o.id === book.bestBid.id}">
                            <span>{{fmt(o.price)}}<span v-if="app.config.multiUnit"> × {{left(o)}}</span></span>
                            <button type="button" v-if="o.maker === me" @click="send('gimsCancel', {id: o.id})" title="Cancel">✕</button>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="muted">Sell orders (asks)</div>
                    <div class="orders">
                        <div v-for="o in book.asks" :key="o.id" :class="{mine: o.maker === me, best: book.bestAsk && o.id === book.bestAsk.id}">
                            <span>{{fmt(o.price)}}<span v-if="app.config.multiUnit"> × {{left(o)}}</span></span>
                            <button type="button" v-if="o.maker === me" @click="send('gimsCancel', {id: o.id})" title="Cancel">✕</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="entry">
                <label v-if="app.config.multiUnit">Units <input type="number" min="1" step="1" v-model="volume"></label>
                <button type="button" class="buy" :disabled="!book.bestAsk || player.role === 'seller'" @click="send('gimsAccept', {asset: sel, side: 'buy', volume: volume - 0, orderId: book.bestAsk && book.bestAsk.id})">Buy<span v-if="book.bestAsk"> at {{fmt(book.bestAsk.price)}}</span></button>
                <button type="button" class="sell" :disabled="!book.bestBid || player.role === 'buyer'" @click="send('gimsAccept', {asset: sel, side: 'sell', volume: volume - 0, orderId: book.bestBid && book.bestBid.id})">Sell<span v-if="book.bestBid"> at {{fmt(book.bestBid.price)}}</span></button>
            </div>
            <div class="entry">
                <label>Price per unit <input type="number" min="0" step="any" v-model="price"></label>
                <button type="button" class="buy" :disabled="player.role === 'seller'" @click="send('gimsOrder', {asset: sel, type: 'buy', price: price - 0, volume: volume - 0})">Submit buy order</button>
                <button type="button" class="sell" :disabled="player.role === 'buyer'" @click="send('gimsOrder', {asset: sel, type: 'sell', price: price - 0, volume: volume - 0})">Submit sell order</button>
            </div>
            <div style="margin-top: 10px">
                <h3>Your other orders</h3>
                <div class="tabs">
                    <button type="button" v-for="f in ['all', 'traded', 'cancelled', 'invalidated']" :key="f" :class="{on: history === f}" @click="history = f; send('gimsHistory', {filter: f})">{{f}}</button>
                </div>
                <div class="scroll"><table>
                    <tr><th>Order</th><th>Price</th><th>Units</th><th>Traded</th><th>Status</th></tr>
                    <tr v-for="o in myHistory" :key="o.id"><td>{{o.type}}</td><td>{{fmt(o.price)}}</td><td>{{o.volume}}</td><td>{{o.transacted}}</td><td>{{o.status}}</td></tr>
                </table></div>
            </div>
        </div>
        <div class="box">
            <div v-if="app.config.showChart">
                <h3>Trade prices this period</h3>
                <svg :viewBox="'0 0 ' + chart.W + ' ' + (chart.H + 14)" style="width: 100%; background: #fff; border: 1px solid #d5dae5; border-radius: 4px">
                    <line v-if="chart.value != null" x1="0" :x2="chart.W" :y1="chart.value" :y2="chart.value" stroke="#999" stroke-dasharray="4 3"></line>
                    <polyline :points="chart.line" fill="none" stroke="#1747c9" stroke-width="1.5"></polyline>
                    <circle v-for="(p, i) in chart.points" :key="i" :cx="p.x" :cy="p.y" r="2.5" fill="#1747c9"></circle>
                    <text x="4" y="12" font-size="10" fill="#667189">{{chart.top}}</text>
                    <text x="4" :y="chart.H + 11" font-size="10" fill="#667189">0 s</text>
                    <text :x="chart.W - 4" :y="chart.H + 11" font-size="10" fill="#667189" text-anchor="end">{{group.tradingTime}} s</text>
                </svg>
                <p class="muted" v-if="chart.value != null">Dashed: the value of a unit.</p>
            </div>
            <div v-if="app.config.showPriceList" style="margin-top: 8px">
                <h3>Trades</h3>
                <div class="scroll"><table>
                    <tr><th>Price</th><th v-if="app.config.multiUnit">Units</th><th>Time</th></tr>
                    <tr v-for="t in priceList" :key="t.id" :class="{mine: t.buyer === me || t.seller === me}"><td>{{fmt(t.price)}}</td><td v-if="app.config.multiUnit">{{t.volume}}</td><td>{{Math.round(t.time)}} s</td></tr>
                </table></div>
            </div>
            <div v-if="group.practice && app.config.practiceTasks" style="margin-top: 8px">
                <h3>Things to try</h3>
                <div v-for="(t, i) in tasksList" :key="i" :class="{done: t.done}">{{t.done ? '✓' : '○'}} {{t.text}}</div>
            </div>
            <div v-if="app.config.earlyEndingVote" style="margin-top: 10px">
                <button type="button" @click="send('gimsVote', {vote: !player.voted})">{{player.voted ? 'Withdraw my vote to end the period' : 'Vote to end the period'}}</button>
                <p class="muted">The period ends early when everyone has voted to end it. You can trade on after voting.</p>
            </div>
        </div>
    </div>
    ${HISTORY}
</div>`;
}

/**
 * Whether the computerized firm trades in a group's period (Haruvy, Noussair and Powell 2014):
 * from its period on in each round, until it has bought (side 'buy', a repurchase) or sold
 * ('sell', an issue) share times the units the traders were given, or units if given.
 */
function firmActive(group) {
    return C.firm != null && !group.practice && group.t >= C.firm.period && group.carried.firmTraded < firmTarget(group);
}
function firmTarget(group) {
    if (C.firm.units != null) return C.firm.units;
    const total = group.players.reduce((s, p) => s + p.initialAssets[C.firm.asset || 0], 0);
    return Math.round(total * C.firm.share);
}
/** Units the firm has traded this round, with this period's. */
function firmTraded(group) {
    const a = C.firm.asset || 0;
    const now = group.trades.rows.filter((t) => t.asset === a && (t.buyer === FIRM || t.seller === FIRM)).reduce((s, t) => s + t.volume, 0);
    return group.carried.firmTraded + now;
}
/**
 * The firm's move, every interval seconds: if the spread is at most threshold, it takes the
 * best order on the other side; otherwise it improves on the best order on its own side by
 * threshold (with none there, it posts threshold away from the other side's). Its new order
 * replaces its old one, and it stops at its target.
 */
function firmAct(group) {
    const F = C.firm;
    const a = F.asset || 0;
    const book = bookOf(group);
    const buy = F.side === 'buy';
    const mine = () => group.orders.rows.filter((o) => o.status === 'open' && o.maker === FIRM);
    if (firmTraded(group) >= firmTarget(group)) {
        for (const o of mine()) market.cancelOrder(book, FIRM, o.id);
        clearInterval(timers.get(group));
        timers.delete(group);
        update(group);
        return;
    }
    // The market's best orders, the firm's own among them (it is on one side only).
    const bid = market.bestOrder(book, a, 'buy');
    const ask = market.bestOrder(book, a, 'sell');
    const other = buy ? ask : bid;
    const spread = bid && ask ? ask.price - bid.price : Infinity;
    const tick = rulesFor(group, a).tickSize || 1;
    if (other && spread <= F.threshold) {
        market.acceptOrder(book, FIRM, { asset: a, side: F.side, volume: 1 });
    } else {
        const own = buy ? bid : ask;
        let price = own ? own.price + (buy ? F.threshold : -F.threshold) : other ? other.price + (buy ? -F.threshold : F.threshold) : null;
        if (price != null) {
            price = Math.max(tick, market.roundToTick(price, tick));
            for (const o of mine()) market.cancelOrder(book, FIRM, o.id);
            market.submitOrder(book, FIRM, { asset: a, type: F.side, price, volume: 1 });
        }
    }
    group.orders.save();
    group.trades.save();
    update(group);
}

// A lottery ticket after each period (Schoenberg and Haruvy 2012): price, a chance of the prize,
// one draw for all.
if (C.lottery != null) {
    const lottery = app.newStage('lottery');
    lottery.groupStart = setUp;
    lottery.wrapPlayingScreenInFormTag = 'yes';
    app.fields = app.fields || {};
    app.fields['player.lotteryTicket'] = { type: 'choice', choices: ['yes', 'no'] };
    lottery.formFields = ['player.lotteryTicket'];
    lottery.validate = function(player, values) {
        if (values['player.lotteryTicket'] === 'yes' && player.cash < C.lottery.price) return { 'player.lotteryTicket': 'You do not have the cash for a ticket.' };
        return undefined;
    };
    lottery.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    <h2>Lottery ticket</h2>
    <p>You can buy a ticket for {{app.config.lottery.price}}. It wins {{app.config.lottery.prize}} with a chance of {{app.config.lottery.chance * 100}}%: one number is drawn, and if it wins, every ticket wins.</p>
    <p><label><input type="radio" name="player.lotteryTicket" value="yes" required> Buy a ticket</label>
       <label><input type="radio" name="player.lotteryTicket" value="no" required> No ticket</label></p>
    <p><button class="primary">OK</button></p>
</div>`;
}

const results = app.newStage('results');
results.groupStart = function(group) {
    setUp(group);
    const book = bookOf(group);
    market.expireOrders(book);
    const carried = group.carried;
    const endDividends = C.dividendTiming === 'end';
    for (let a = 0; a < numAssets; a++) {
        const asset = C.assets[a];
        if (asset.walk) {
            group.dividend[a] = 0;
        } else {
            const preset = asset.dividendSequence && !group.practice ? asset.dividendSequence[group.t - 1] : undefined;
            group.dividend[a] = endDividends ? null : preset != null ? preset : market.drawDividend(asset.dividends);
            // A truncated asset pays nothing after maxPayouts dividends that are not zero.
            if (asset.maxPayouts != null && group.dividend[a]) {
                if (carried.payouts[a] >= asset.maxPayouts) group.dividend[a] = 0;
                else carried.payouts[a]++;
            }
        }
        carried.perUnit[a] = round2(carried.perUnit[a] + (group.dividend[a] || 0) - taxIn(a, group.t));
        const trades = group.trades.rows.filter((t) => t.asset === a);
        group.stats[a] = Object.assign(market.priceStats(trades), { value: group.value[a] });
    }
    // News of the final value after the period (stateSignals with when 'end'), not after the last.
    if (C.stateSignals && C.stateSignals.when === 'end' && !group.lastPeriod) {
        const S = C.stateSignals;
        const values = market.dividendProcess(C.assets[S.asset || 0].buyback).values;
        const high = secretOf(group).final[S.asset || 0] >= Math.max(...values);
        const right = Math.random() < S.accuracy;
        group.news = (S.labels || ['good news', 'bad news'])[high === right ? 0 : 1];
    }
    if (C.lottery != null) group.lotteryWin = Math.random() < C.lottery.chance;
    // Dividends drawn at the end (Ackert, Kluger and Qi 2012): one for each period, for the units held then.
    if (endDividends && group.lastPeriod) {
        group.endDividends = C.assets.map((asset) => {
            const out = [];
            let paid = 0;
            for (let t = 1; t <= group.T; t++) {
                let d = market.drawDividend(asset.dividends);
                if (asset.maxPayouts != null && d) d = paid++ < asset.maxPayouts ? d : 0;
                out.push(d);
            }
            return out;
        });
    }
    // A value path's step after the period: the value of the next period, or after the last, the final value.
    for (let a = 0; a < numAssets; a++) {
        if (C.assets[a].walk) carried.walk[a] = round2(carried.walk[a] + walkStep(C.assets[a].walk));
    }
    if (group.lastPeriod) group.final = C.assets.map((x, a) => round2(finalValueOf(group, a)));
    const target = forecastTarget(group);
    for (const player of group.players) {
        // Bonds back, interest on cash held after trading, then dividends, taxes, the cash inflow and the lottery.
        if (player.bond > 0) {
            player.bondInterest = round2(player.bond * group.bondRate);
            player.cash = round2(player.cash + player.bond + (C.bonds.payAtEnd ? 0 : player.bondInterest));
            if (C.bonds.payAtEnd) player.account = round2(player.account + player.bondInterest);
        }
        player.interestEarned = C.interest && player.cash > 0 ? round2(player.cash * C.interest) : 0;
        player.cash = round2(player.cash + player.interestEarned);
        player.held.push(player.assets.slice());
        if (endDividends) {
            player.dividends = 0;
            if (group.lastPeriod) {
                player.dividends = round2(player.held.reduce((s, units, t) => s + units.reduce((s2, u, a) => s2 + u * group.endDividends[a][t], 0), 0));
            }
        } else {
            player.dividends = round2(C.assets.reduce((s, x, a) => s + player.assets[a] * group.dividend[a], 0));
        }
        player.tax = round2(C.assets.reduce((s, x, a) => s + player.assets[a] * taxIn(a, group.t), 0));
        if (C.dividendAccount === 'separate') player.account = round2(player.account + player.dividends - player.tax);
        else player.cash = round2(player.cash + player.dividends - player.tax);
        player.inflow = group.practice ? 0 : inflowIn(group.t);
        player.cash = round2(player.cash + player.inflow);
        if (C.lottery != null && player.lotteryTicket === 'yes') {
            player.lotteryResult = round2((group.lotteryWin ? C.lottery.prize : 0) - C.lottery.price);
            player.cash = round2(player.cash + player.lotteryResult);
        }
        scoreForecasts(player, group, target);
        if (group.lastPeriod) {
            const holdings = C.assets.reduce((s, a, i) => s + player.assets[i] * group.final[i], 0);
            player.buybackValue = round2(holdings);
            player.finalCash = round2(player.cash + player.account + holdings);
            let base = C.loan ? player.initialCash : 0;
            // With carryCash, a round's earnings are what it added to the cash it began with.
            if (C.carryCash && group.round > 1) base = player.initialCash;
            // With payoff 'profit', earnings are what the endowment would not have paid had it been held.
            if (C.payoff === 'profit') base = player.initialCash + C.assets.reduce((s, x, a) => s + player.initialAssets[a] * (carried.perUnit[a] + group.final[a]), 0);
            player.roundPayoff = round2(player.finalCash + C.bonus - base);
        }
    }
    accountStatus(group);
    // The market's history: a row a period.
    carried.past.push({
        t: group.t,
        mean: group.stats.map((x) => (x.mean == null ? null : round2(x.mean))),
        last: C.assets.map((x, a) => lastPriceOf(group, a)),
        value: group.value.slice(),
        dividend: group.dividend.slice(),
        news: group.news,
    });
    if (C.firm) carried.firmTraded = firmTraded(group);
    for (const player of group.players) {
        player.carried = carried;
        refresh(player);
    }
    group.orders.save();
    group.trades.save();
};

/**
 * The account status (accountStatus, Schoenberg and Haruvy 2012): each trader's cash and units at
 * the share price, the highest bid of the period (or, with none, the last price), and the
 * largest ('highest') or smallest ('lowest') such total in the market.
 */
function accountStatus(group) {
    if (C.accountStatus == null) return;
    group.sharePrice = C.assets.map((x, a) => {
        const bids = group.orders.rows.filter((o) => o.asset === a && o.type === 'buy' && o.price != null);
        return bids.length > 0 ? Math.max(...bids.map((o) => o.price)) : lastPriceOf(group, a) || 0;
    });
    for (const p of group.players) {
        p.accountTotal = round2(p.cash + p.account + C.assets.reduce((s, x, a) => s + p.assets[a] * group.sharePrice[a], 0));
    }
    const totals = group.players.map((p) => p.accountTotal);
    group.reference = C.accountStatus.reference === 'lowest' ? Math.min(...totals) : Math.max(...totals);
}

if (C.rating != null) {
    app.fields = app.fields || {};
    app.fields['player.rating'] = { type: 'int', min: 1, max: C.rating.labels.length };
    results.formFields = ['player.rating'];
}
if (C.resultsTime > 0) results.duration = C.resultsTime;
results.wrapPlayingScreenInFormTag = 'yes';
results.activeScreen = STYLE + `
<div class="gims">
    ${BAR}
    <h2>Results of the period</h2>
    <table style="max-width: 720px">
        <tr><th>Asset</th><th>Dividend a unit</th><th v-if="hasTax">Tax a unit</th><th v-if="hasWalk">Value now</th><th>Mean price</th><th>Units traded</th><th>You hold</th></tr>
        <tr v-for="(a, i) in app.config.assets" :key="i"><td>{{a.name}}</td><td>{{!a.paysDividends || !group.dividend ? '–' : fmt(group.dividend[i])}}</td><td v-if="hasTax">{{fmt(taxNow(i))}}</td>
            <td v-if="hasWalk">{{a.walk && group.carried ? fmt(group.carried.walk[i]) : '–'}}</td>
            <td>{{group.stats[i] ? fmt(group.stats[i].mean) : '–'}}</td><td>{{group.stats[i] ? group.stats[i].volume : 0}}</td><td>{{player.assets[i]}}</td></tr>
    </table>
    <p v-if="group.news" class="notice" style="max-width: 720px; margin-top: 10px">News: <b>{{group.news}}</b></p>
    <p v-if="app.config.dividendTiming === 'end' && !group.lastPeriod" class="muted">Dividends are drawn after the last period, one for each period, for the units held then.</p>
    <table style="max-width: 420px; margin-top: 10px">
        <tr v-if="player.bond"><td>Bonds back, and interest at {{fmt(group.bondRate * 100)}}%</td><td>{{fmt(player.bond)}} + {{fmt(player.bondInterest)}}</td></tr>
        <tr v-if="paysAny"><td>Dividends you received</td><td>{{fmt(player.dividends)}}</td></tr>
        <tr v-if="player.tax > 0"><td>Holding taxes you paid</td><td>{{fmt(player.tax)}}</td></tr>
        <tr v-if="player.tax < 0"><td>Subsidies you received</td><td>{{fmt(-player.tax)}}</td></tr>
        <tr v-if="app.config.interest"><td>Interest on your cash</td><td>{{fmt(player.interestEarned)}}</td></tr>
        <tr v-if="player.inflow"><td>Cash you received</td><td>{{fmt(player.inflow)}}</td></tr>
        <tr v-if="player.lotteryTicket === 'yes'"><td>Lottery ticket ({{group.lotteryWin ? 'won' : 'did not win'}})</td><td>{{fmt(player.lotteryResult)}}</td></tr>
        <tr v-if="app.config.forecasts"><td>Forecast earnings</td><td>{{fmt(player.forecastEarnings)}}</td></tr>
        <tr><td><b>Your cash</b></td><td><b>{{fmt(player.cash)}}</b> {{app.config.cashName}}</td></tr>
        <tr v-if="app.config.separateAccount"><td>Your {{accountName().toLowerCase()}}</td><td>{{fmt(player.account)}}</td></tr>
    </table>
    <div v-if="app.config.accountStatus && group.sharePrice" class="box" style="max-width: 420px; margin-top: 10px">
        <h3>Account status</h3>
        <table>
            <tr v-for="(a, i) in app.config.assets" :key="i"><td>Price of {{a.name}} (the best bid this period)</td><td>{{fmt(group.sharePrice[i])}}</td></tr>
            <tr><td>Your account total (cash and units at that price)</td><td><b>{{fmt(player.accountTotal)}}</b></td></tr>
            <tr><td>The {{app.config.accountStatus.reference === 'lowest' ? 'smallest' : 'largest'}} account total in the market</td><td><b>{{fmt(group.reference)}}</b></td></tr>
        </table>
    </div>
    <div v-if="group.final && (hasWalk || app.config.drawnFinal.includes(true) || group.endDividends)" class="box" style="max-width: 420px; margin-top: 10px">
        <div v-for="(a, i) in app.config.assets" :key="i" v-if="a.walk || app.config.drawnFinal[i]">After the last period, a unit of {{a.name}} pays <b>{{fmt(group.final[i])}}</b>.</div>
        <div v-if="group.endDividends">The dividends drawn: <span v-for="(a, i) in app.config.assets" :key="i">{{a.name}}: {{group.endDividends[i].join(', ')}}. </span></div>
    </div>
    <div v-if="player.roundPayoff != null" class="box" style="max-width: 420px; margin-top: 10px">
        <b v-if="group.practice">This was the end of the practice. Your earnings in it would have been {{fmt(player.roundPayoff)}}; they do not count.</b>
        <b v-else>This market is over. Your earnings in it: {{fmt(player.roundPayoff)}} {{app.config.cashName}}</b>
        <div class="muted">{{earningsText()}}</div>
    </div>
    <div v-if="app.config.rating" class="question" style="max-width: 720px">
        <b>{{app.config.rating.question}}</b>
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px">
            <label v-for="(l, i) in app.config.rating.labels" :key="i" style="display: inline"><input type="radio" name="player.rating" :value="i + 1" required> {{l}}</label>
        </div>
    </div>
    <p><button class="primary">Continue</button></p>
</div>`;

/** The price each forecast of this period is scored against: { price } or null. */
function forecastTarget(group) {
    const f = C.forecasts;
    if (f == null || group.practice) return null;
    const a = f.asset || 0;
    if (f.target === 'call') return group.auction[a] && group.auction[a].price != null ? group.auction[a].price : null;
    const stats = market.priceStats(group.trades.rows.filter((t) => t.asset === a && (t.phase === 'cda' || !C.cda)));
    return stats[f.target] != null ? stats[f.target] : null;
}

/** Pays a player for the forecasts made for this period (this period's and earlier ones'). */
function scoreForecasts(player, group, price) {
    player.forecastEarnings = 0;
    player.forecastResults = [];
    if (C.forecasts == null || group.practice) return;
    const start = group.period.id - group.t + 1;
    for (let s = 1; s <= group.t; s++) {
        const made = player.inPeriod(start + s - 1);
        const forecast = made && made.forecasts ? made.forecasts[group.t] : undefined;
        if (forecast == null) continue;
        let reward = 0;
        if (price != null && price > 0) {
            const error = Math.abs(forecast - price) / price;
            const tier = C.forecasts.rewards.find((r) => error <= r[0] + 1e-9);
            reward = tier ? tier[1] : 0;
        }
        player.forecastResults.push({ madeIn: s, forecast, price, reward });
        player.forecastEarnings += reward;
    }
    player.account = round2(player.account + player.forecastEarnings);
}

if (C.crt === 'after') addTask('../crt', crtOptions, 'crtAfter', inLastPeriod, 'The three questions');
if (C.holtLaury === 'after') addTask('../holt-laury', holtLauryOptions, 'riskAfter', inLastPeriod, 'The lottery choices');

/**
 * A participant's points in this app so far, in its periods and in the apps it has as stages; or,
 * with stageId, in the app that is that stage alone.
 */
function pointsSoFar(participant, stageId) {
    let sum = 0;
    for (const k in participant.players) {
        const p = participant.players[k];
        const a = p.app();
        if (a.rootApp() !== app) continue;
        if (stageId != null && (a.parentStage == null || a.parentStage.id !== stageId)) continue;
        sum += Number(p.points) || 0;
    }
    return round2(sum);
}

const payment = app.newStage('payment');
payment.canPlayerParticipate = inLastPeriod;
payment.groupStart = function(group) {
    setUp(group);
    if (group.period.id !== app.numPeriods) return;
    const firstOfRound = (r) => C.practicePeriods + (r - 1) * C.periods + 1;
    // With payment 'random', one round is paid, or one from each block of rounds (paymentBlocks).
    group.paidRounds = null;
    if (C.payment === 'random') {
        const blocks = C.paymentBlocks || [C.rounds];
        let first = 1;
        group.paidRounds = blocks.map((n) => {
            const r = first + draw(n) - 1;
            first += n;
            return r;
        });
    }
    group.paidRound = group.paidRounds && group.paidRounds.length === 1 ? group.paidRounds[0] : null;
    for (const player of group.players) {
        const payoffs = [];
        for (let r = 1; r <= C.rounds; r++) {
            const last = player.inPeriod(firstOfRound(r) + C.periods - 1);
            payoffs.push(last ? last.roundPayoff : 0);
        }
        player.roundPayoffs = payoffs;
        player.marketEarnings = round2(group.paidRounds != null ? group.paidRounds.reduce((s, r) => s + payoffs[r - 1], 0) : payoffs.reduce((s, x) => s + x, 0));
        player.taskEarnings = TASKS.map((t) => ({ label: t.label, points: pointsSoFar(player.participant, t.id) })).filter((t) => t.points !== 0);
        const before = pointsSoFar(player.participant);
        player.topUp = Math.max(0, round2(C.minPayoff - (before + player.marketEarnings)));
        // With maxPayoff, earnings above it are cut (a negative top-up).
        if (C.maxPayoff != null) player.topUp = Math.min(player.topUp, round2(C.maxPayoff - (before + player.marketEarnings)));
        player.points = round2((player.points || 0) + player.marketEarnings + player.topUp);
        player.totalPoints = round2(before + player.marketEarnings + player.topUp);
        player.save();
    }
};
payment.wrapPlayingScreenInFormTag = 'yes';
payment.activeScreen = STYLE + `
<div class="gims">
    <h2>Your earnings</h2>
    <table style="max-width: 460px">
        <tr v-for="(x, i) in player.roundPayoffs" :key="i"><td>Market {{i + 1}}<span v-if="group.paidRounds && group.paidRounds.includes(i + 1)"> (drawn for payment)</span></td><td>{{fmt(x)}}</td></tr>
        <tr v-for="(t, i) in player.taskEarnings" :key="'task' + i"><td>{{t.label}}</td><td>{{fmt(t.points)}}</td></tr>
        <tr v-if="player.topUp > 0"><td>Up to the minimum payment</td><td>{{fmt(player.topUp)}}</td></tr>
        <tr v-if="player.topUp < 0"><td>Down to the maximum payment</td><td>{{fmt(player.topUp)}}</td></tr>
        <tr><td><b>In all</b></td><td><b>{{fmt(player.totalPoints)}}</b> {{app.config.cashName}}</td></tr>
        <tr v-if="moneyRate() != null"><td>In money</td><td><b>{{(player.totalPoints * moneyRate()).toFixed(2)}}</b> {{participant.session && participant.session.currency || ''}}</td></tr>
    </table>
    <p><button class="primary">OK</button></p>
</div>`;

// Messages from the trading screens.

function marketMessage(participant, data, act) {
    const player = playerIn(participant, 'trading');
    if (player == null || data == null) return;
    const result = act(player, bookOf(player.group));
    if (result && result.error) {
        notify(player, result.error);
        return;
    }
    player.notice = null;
    const group = player.group;
    // The firm stops as soon as it has reached its target.
    if (C.firm && timers.has(group) && firmTraded(group) >= firmTarget(group)) firmAct(group);
    group.orders.save();
    group.trades.save();
    update(group);
}

app.messages.gimsOrder = function(data) {
    marketMessage(this.participant, data, (player, book) => {
        const asset = assetIndex(data.asset);
        if (asset == null) return { error: 'Unknown asset.' };
        const result = market.submitOrder(book, player.idInGroup, { asset, type: data.type, price: data.price, volume: data.volume });
        if (!result.error) player.tasks[data.type === 'buy' ? 'buyOrder' : 'sellOrder'] = true;
        return result;
    });
};

app.messages.gimsCancel = function(data) {
    marketMessage(this.participant, data, (player, book) => {
        const result = market.cancelOrder(book, player.idInGroup, data.id);
        if (!result.error) player.tasks.cancel = true;
        return result;
    });
};

app.messages.gimsAccept = function(data) {
    marketMessage(this.participant, data, (player, book) => {
        const asset = assetIndex(data.asset);
        if (asset == null) return { error: 'Unknown asset.' };
        const result = market.acceptOrder(book, player.idInGroup, { asset, side: data.side, volume: data.volume, orderId: data.orderId });
        if (!result.error) player.tasks[data.side === 'buy' ? 'acceptSell' : 'acceptBuy'] = true;
        return result;
    });
};

// The history filter a trader looks at, logged as GIMS's timelog does.
app.messages.gimsHistory = function(data) {
    const player = playerIn(this.participant, 'trading');
    if (player == null || data == null) return;
    player.historyFilter = String(data.filter);
};

app.messages.gimsVote = function(data) {
    const player = playerIn(this.participant, 'trading');
    if (player == null || data == null || !C.earlyEndingVote) return;
    player.voted = data.vote === true;
    const group = player.group;
    if (group.players.every((p) => p.voted || p.status !== 'playing')) {
        group.forceEndStage(player.stage);
        return;
    }
    update(group);
};

app.messages.gimsCallOrder = function(data) {
    const player = playerIn(this.participant, 'callAuction');
    if (player == null || data == null) return;
    const asset = assetIndex(data.asset);
    if (asset == null) return notify(player, 'Unknown asset.');
    const rules = rulesFor(player.group, asset);
    const isMarket = data.price == null;
    if (isMarket && !rules.marketOrders) return notify(player, 'Market orders are not allowed: enter a price.');
    if (data.type !== 'buy' && data.type !== 'sell') return notify(player, 'Unknown order type.');
    const read = market.readOrder(rules, data.price, data.volume, { market: isMarket });
    if (read.error) return notify(player, read.error);
    const order = { id: (player.callOrders.reduce((m, o) => Math.max(m, o.id), 0) + 1), asset, type: data.type, price: read.price, volume: read.volume, time: round2((Date.now() - player.group.marketStart) / 1000) };
    const mine = player.callOrders.filter((o) => o.asset === asset);
    const check = market.checkCallOrders(player, rules, asset, mine.concat([order]));
    if (check.error) return notify(player, check.error);
    player.callOrders.push(order);
    player.notice = null;
    player.saveAndUpdate();
};

app.messages.gimsChat = function(data) {
    const player = playerIn(this.participant, 'chat');
    if (player == null || data == null) return;
    const text = String(data.text || '').trim().slice(0, 300);
    if (text === '') return;
    const group = player.group;
    // The sender's wealth: cash, and units at the last prices (at their value, for an asset not yet traded).
    const wealth = round2(player.cash + C.assets.reduce((s, x, a) => {
        const price = lastPriceOf(group, a);
        return s + player.assets[a] * (price == null ? group.value[a] : price);
    }, 0));
    group.chat.new({ from: player.idInGroup, text, wealth, time: Date.now() });
    group.chat.save();
    update(group);
};

app.messages.gimsCallCancel = function(data) {
    const player = playerIn(this.participant, 'callAuction');
    if (player == null || data == null) return;
    player.callOrders = player.callOrders.filter((o) => o.id !== data.id);
    player.notice = null;
    player.saveAndUpdate();
};
