// An account status (Schoenberg and Haruvy 2012): each participant's account total, and the
// largest ('highest') or smallest ('lowest') total in their group.
//
// An app of its own, or a stage of each period of the market (../market), after the period's
// results: there, a trader's total is their cash, account and units at the share price, the
// highest bid of the period (or, with none, the last price). Played alone, a participant's total
// is their points in the session so far.

const here = path.dirname(path.resolve(app.appPath));
function load(file) {
    const fn = path.join(here, file);
    delete require.cache[require.resolve(fn)];
    return require(fn);
}
const presets = load('presets.js');

app.addSelectOption('preset', Object.keys(presets.PRESETS), 'The account status: an example, or a study\'s (presets.js).');
app.addTextOption('changes', '', 'Settings to change, as JSON: {"accountStatus": {"reference": "lowest"}}.');
const C = presets.settingsFor(app.preset, app.changes);
app.config = C;
const reference = C.accountStatus && C.accountStatus.reference === 'lowest' ? 'lowest' : 'highest';
app.description = 'An account status: each participant\'s total, and the ' + (reference === 'lowest' ? 'smallest' : 'largest') + ' in their group.';
app.stageWrapPlayingScreenInFormTag = 'yes';

// As a stage of another app, its groups are that app's, in its order.
const ownGroups = app.getGroupIdsForPeriod;
app.getGroupIdsForPeriod = function(period) {
    if (this.parentPeriod == null) return ownGroups.call(this, period);
    const place = (id) => this.parentPeriod.playerByParticipantId(id).idInGroup;
    return this.playingGroupIds().map((ids) => ids.slice().sort((a, b) => place(a) - place(b)));
};

/** The player whose stage this app is (the market's), or, when this app is played alone, the player. */
function hostOf(player) {
    const run = player.app();
    const host = run.parentPeriod == null ? null : run.parentPeriod.playerByParticipantId(player.participant.id);
    return host == null ? player : host;
}

/** In a market: where its period is ({ practice, round, t, T }); null for an app that is not one. */
function placeOf(player) {
    const market = player.app();
    return typeof market.periodInfo === 'function' ? Object.assign(market.periodInfo(player.group.period.id), { rounds: market.config.rounds }) : null;
}

const round2 = (x) => Math.round(x * 100) / 100;

/** The last trade price of asset a in a market (its group) this round, or null. */
function lastPriceIn(market, a) {
    const trades = market.trades ? market.trades.rows.filter((t) => t.asset === a) : [];
    if (trades.length > 0) return trades[trades.length - 1].price;
    const past = market.carried ? market.carried.past : [];
    for (let i = past.length - 1; i >= 0; i--) if (past[i].last[a] != null) return past[i].last[a];
    return null;
}

const status = app.newStage('accountStatus');
status.groupStart = function(group) {
    const host0 = hostOf(group.players[0]);
    group.place = placeOf(host0);
    if (group.place == null) {
        // Played alone: points so far.
        group.assets = [];
        for (const p of group.players) p.accountTotal = round2(p.participant.points());
    } else {
        const market = host0.group;
        const M = host0.app().config;
        group.assets = M.assets.map((x, a) => {
            const bids = market.orders.rows.filter((o) => o.asset === a && o.type === 'buy' && o.price != null);
            return { name: x.name, price: bids.length > 0 ? Math.max(...bids.map((o) => o.price)) : lastPriceIn(market, a) || 0 };
        });
        for (const p of group.players) {
            const host = hostOf(p);
            p.accountTotal = round2(host.cash + (host.account || 0) + group.assets.reduce((s, x, a) => s + host.assets[a] * x.price, 0));
            host.accountTotal = p.accountTotal;
            host.save();
        }
    }
    const totals = group.players.map((p) => p.accountTotal);
    group.reference = reference === 'lowest' ? Math.min(...totals) : Math.max(...totals);
    group.referenceName = reference === 'lowest' ? 'smallest' : 'largest';
};
status.activeScreen = `
<style>
.task { font-family: system-ui, -apple-system, Segoe UI, sans-serif; font-size: 15px; color: #1d2433; max-width: 760px; margin: 0 auto; padding: 12px; }
.task h2 { font-size: 20px; margin: 0 0 8px; }
.task .bar { background: #233; color: #fff; padding: 8px 12px; border-radius: 6px; }
.task table { border-collapse: collapse; font-variant-numeric: tabular-nums; }
.task td { padding: 3px 10px; }
.task td + td { text-align: right; }
.task button { padding: 5px 14px; border-radius: 4px; border: 1px solid #233; background: #233; color: #fff; cursor: pointer; font: inherit; }
</style>
<div class="task">
    <p class="bar" v-if="group.place"><span v-if="group.place.practice">Practice period {{group.place.t}} of {{group.place.T}}</span><span v-else>Period {{group.place.t}} of {{group.place.T}}<span v-if="group.place.rounds > 1"> · Market {{group.place.round}} of {{group.place.rounds}}</span></span></p>
    <h2>Account status</h2>
    <table>
        <tr v-for="(a, i) in group.assets" :key="i"><td>Price of {{a.name}} (the best bid this period)</td><td>{{a.price}}</td></tr>
        <tr><td>Your account total<span v-if="group.place"> (cash and units at that price)</span></td><td><b>{{player.accountTotal}}</b></td></tr>
        <tr><td>The {{group.referenceName}} account total in <span v-if="group.place">the market</span><span v-else>your group</span></td><td><b>{{group.reference}}</b></td></tr>
    </table>
    <p><button>OK</button></p>
</div>`;
